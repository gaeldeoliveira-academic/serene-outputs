@PACKAGE_INIT@
set(_serene_outputs_prefix "${PACKAGE_PREFIX_DIR}")
set(SereneOutputs_VERSION "@PROJECT_VERSION@")
if(NOT SereneOutputs_FIND_COMPONENTS)
  if(@SERENE_OUTPUTS_BUILD_ARCHIVE@)
    set(SereneOutputs_FIND_COMPONENTS archive)
  elseif(@SERENE_OUTPUTS_BUILD_CODEC@)
    set(SereneOutputs_FIND_COMPONENTS codec)
  else()
    set(SereneOutputs_FIND_COMPONENTS model)
  endif()
endif()
foreach(_component IN LISTS SereneOutputs_FIND_COMPONENTS)
  if(NOT _component MATCHES "^(model|codec|archive)$")
    set(SereneOutputs_FOUND FALSE)
    set(SereneOutputs_NOT_FOUND_MESSAGE "Unknown SereneOutputs component: ${_component}")
    return()
  endif()
endforeach()
set(_need_codec FALSE)
set(_need_archive FALSE)
if("codec" IN_LIST SereneOutputs_FIND_COMPONENTS OR "archive" IN_LIST SereneOutputs_FIND_COMPONENTS)
  set(_need_codec TRUE)
endif()
if("archive" IN_LIST SereneOutputs_FIND_COMPONENTS)
  set(_need_archive TRUE)
endif()
if(NOT TARGET serene::outputs_model)
  include("${CMAKE_CURRENT_LIST_DIR}/SereneOutputsModelTargets.cmake")
endif()
set(SereneOutputs_model_FOUND TRUE)
if(_need_codec)
  if(NOT @SERENE_OUTPUTS_BUILD_CODEC@)
    set(SereneOutputs_codec_FOUND FALSE)
    set(SereneOutputs_NOT_FOUND_MESSAGE "This installation was built without the codec component")
  else()
    if(NOT TARGET serene::outputs_zfp_dependency)
      add_library(serene::outputs_zfp_dependency STATIC IMPORTED)
      file(GLOB _configs "${CMAKE_CURRENT_LIST_DIR}/SereneOutputsZfp-*.cmake")
      foreach(_config IN LISTS _configs)
        include("${_config}")
      endforeach()
      if(UNIX)
        set_property(TARGET serene::outputs_zfp_dependency PROPERTY INTERFACE_LINK_LIBRARIES m)
      endif()
    endif()
    if(NOT TARGET serene::outputs_codec)
      include("${CMAKE_CURRENT_LIST_DIR}/SereneOutputsCodecTargets.cmake")
    endif()
    set(SereneOutputs_codec_FOUND TRUE)
  endif()
endif()
if(_need_archive)
  if(NOT @SERENE_OUTPUTS_BUILD_ARCHIVE@)
    set(SereneOutputs_archive_FOUND FALSE)
    set(SereneOutputs_NOT_FOUND_MESSAGE "This installation was built without native archive writer")
  else()
    if(NOT TARGET serene::outputs_archive)
      include("${CMAKE_CURRENT_LIST_DIR}/SereneOutputsArchiveTargets.cmake")
    endif()
    set(SereneOutputs_archive_FOUND TRUE)
  endif()
endif()
# Never silently satisfy Debug (/MDd) with Release (/MD), or vice versa.
# Multi-config consumers must install both runtime families or restrict their configuration set.
if(MSVC)
  foreach(_target outputs_model outputs_codec outputs_archive outputs_zfp_dependency)
    if(TARGET serene::${_target})
      set_target_properties(serene::${_target} PROPERTIES
        MAP_IMPORTED_CONFIG_DEBUG Debug
        MAP_IMPORTED_CONFIG_RELEASE Release
        MAP_IMPORTED_CONFIG_RELWITHDEBINFO "RelWithDebInfo;Release"
        MAP_IMPORTED_CONFIG_MINSIZEREL "MinSizeRel;Release")
    endif()
  endforeach()
endif()
check_required_components(SereneOutputs)
unset(_serene_outputs_prefix)
